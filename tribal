# Remove existing tribal hook block from a file (if present)
remove_hook_block() {
  local file="$1"
  [ -f "$file" ] || return 0
  if grep -q "$HOOK_START" "$file" 2>/dev/null; then
    local tmp
    tmp=$(mktemp)
    awk -v start="$HOOK_START" -v end="$HOOK_END" '
      $0 ~ start { skip=1; next }
      $0 ~ end { skip=0; next }
      !skip { print }
    ' "$file" > "$tmp"
    # Remove trailing blank lines left behind
    sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$file"
    rm -f "$tmp"
  fi
}

# Inject a hook block into a file
inject_hook_block() {
  local file="$1"
  local block="$2"

  # Remove existing block first
  remove_hook_block "$file"

  # Append block
  if [ -f "$file" ]; then
    echo "" >> "$file"
  fi
  echo "$block" >> "$file"
}

# ── Command: hook ─────────────────────────────────────────────
cmd_hook() {
  local do_claude=0 do_cursor=0 do_codex=0

  if [ $# -eq 0 ]; then
    do_claude=1; do_cursor=1; do_codex=1
  fi

  while [ $# -gt 0 ]; do
    case "$1" in
      claude)  do_claude=1; shift ;;
      cursor)  do_cursor=1; shift ;;
      codex)   do_codex=1; shift ;;
      --all)   do_claude=1; do_cursor=1; do_codex=1; shift ;;
      *)       die "Unknown target for hook: $1. Use: claude, cursor, codex, or --all" ;;
    esac
  done

  if [ "$do_claude" -eq 1 ]; then
    local block
    block=$(hook_block_claude)
    inject_hook_block "CLAUDE.md" "$block"
    info "Hooked tribal into CLAUDE.md"
  fi

  if [ "$do_cursor" -eq 1 ]; then
    local block
    block=$(hook_block_cursor)
    inject_hook_block ".cursorrules" "$block"
    info "Hooked tribal into .cursorrules"
  fi

  if [ "$do_codex" -eq 1 ]; then
    local block
    block=$(hook_block_codex)
    inject_hook_block "codex.md" "$block"
    info "Hooked tribal into codex.md"
  fi

  info "Tribal knowledge is now active for this project. Commit the changes to share with your team."
}

# ── Command: unhook ───────────────────────────────────────────
cmd_unhook() {
  local do_claude=0 do_cursor=0 do_codex=0

  if [ $# -eq 0 ]; then
    do_claude=1; do_cursor=1; do_codex=1
  fi

  while [ $# -gt 0 ]; do
    case "$1" in
      claude)  do_claude=1; shift ;;
      cursor)  do_cursor=1; shift ;;
      codex)   do_codex=1; shift ;;
      --all)   do_claude=1; do_cursor=1; do_codex=1; shift ;;
      *)       die "Unknown target for unhook: $1. Use: claude, cursor, codex, or --all" ;;
    esac
  done

  if [ "$do_claude" -eq 1 ]; then
    local block
    block=$(unhook_block_claude)
    inject_hook_block "CLAUDE.md" "$block"
    info "Unhooked tribal from CLAUDE.md (opt-out block added)"
  fi

  if [ "$do_cursor" -eq 1 ]; then
    local block
    block=$(unhook_block_cursor)
    inject_hook_block ".cursorrules" "$block"
    info "Unhooked tribal from .cursorrules (opt-out block added)"
  fi

  if [ "$do_codex" -eq 1 ]; then
    local block
    block=$(unhook_block_codex)
    inject_hook_block "codex.md" "$block"
    info "Unhooked tribal from codex.md (opt-out block added)"
  fi

  info "Tribal knowledge is disabled for this project. Commit the changes to share with your team."
}

# ── Command: help ─────────────────────────────────────────────
cmd_help() {
  local subcmd="${1:-}"

  if [ -z "$subcmd" ]; then
    cat << 'HELP'
tribal — git-backed tribal knowledge manager

Usage: tribal <command> [options]

Commands:
  init [path]           Initialize a new knowledge base
  add [options]         Add a new knowledge entry
  search <query>        Search entries with ranked results
  list [--category]     List all entries
  update <slug>         Edit an existing entry
  verify <slug>         Mark entry as verified
  reindex               Rebuild INDEX.md
  stats                 Show knowledge base statistics
  link [--claude|--cursor|--codex|--all]
                        Install global LLM skill files
  hook [claude|cursor|codex|--all]
                        Add tribal instructions to this project's CLAUDE.md / .cursorrules
  unhook [claude|cursor|codex|--all]
                        Opt this project out of tribal knowledge
  help [command]        Show help
  version               Show version

Run 'tribal help <command>' for details on a specific command.
HELP
    return
  fi

  case "$subcmd" in
    add)
      cat << 'HELP'
tribal add — Add a new knowledge entry

Usage: tribal add [options]

Options:
  --title TEXT        Entry title (required; interactive if omitted)
  --category CAT     Category (environment|debugging|architecture|process|tooling|testing|deployment|security)
  --tags TAGS        Comma-separated tags
  --confidence LVL   Confidence level (high|medium|low) [default: medium]
  --summary TEXT      One-line summary
  --body TEXT         Entry body content
  --force            Skip security check

If no --title is given, enters interactive mode.
HELP
      ;;
    search)
      cat << 'HELP'
tribal search — Search entries with ranked results

Usage: tribal search <query> [options]

Options:
  --category CAT     Filter by category
  --tags TAGS        Filter by tags
  --test             Exit with code 0 if results found, 1 if none

Results are ranked by: tag match (10) > title match (7) > body match (3),
with bonuses for recency and confidence level.
HELP
      ;;
    *)
      echo "No detailed help for: $subcmd"
      echo "Run 'tribal help' for command list."
      ;;
  esac
}

# ── Argument Parser (main) ────────────────────────────────────
main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init)    cmd_init "$@" ;;
    add)     cmd_add "$@" ;;
    search)  cmd_search "$@" ;;
    list)    cmd_list "$@" ;;
    update)  cmd_update "$@" ;;
    verify)  cmd_verify "$@" ;;
    reindex) cmd_reindex "$@" ;;
    stats)   cmd_stats "$@" ;;
    link)    cmd_link "$@" ;;
    hook)    cmd_hook "$@" ;;
    unhook)  cmd_unhook "$@" ;;
    help|--help|-h) cmd_help "$@" ;;
    version|--version|-v) echo "tribal $TRIBAL_VERSION" ;;
    *)       die "Unknown command: $cmd. Run 'tribal help' for usage." ;;
  esac
}

main "$@"
